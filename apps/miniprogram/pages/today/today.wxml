<view class="page">
  <topbar>
    <view slot="right" class="topbtn" bindtap="openCalendar">
      <image class="topbtn-ic" src="/assets/icons/calendar.svg" />
      <text>月计划</text>
    </view>
  </topbar>

  <view wx:if="{{preview}}" class="preview-banner">本地预览数据 · 未连接云开发</view>

  <view class="greet rise">
    <view class="greet-text">
      <view class="eyebrow">{{eyebrow}}</view>
      <view class="h1">{{greeting}}{{name ? '，' + name : ''}}</view>
      <view class="sub">今天也照顾好自己的身体。</view>
    </view>
    <view wx:if="{{name}}" class="avatar num">{{name[0]}}</view>
  </view>

  <view class="datestrip rise" style="animation-delay: .05s">
    <view wx:for="{{strip}}" wx:key="date" class="dcell {{item.selected ? 'sel' : ''}}" data-date="{{item.date}}" bindtap="selectDate">
      <text class="wd">{{item.weekday}}</text>
      <text class="dn num">{{item.day}}</text>
      <view class="dot"></view>
    </view>
  </view>

  <block wx:if="{{status === 'ready'}}">
    <plan-day day="{{day}}" done="{{done}}" bind:toggle="onToggle">
      <view slot="middle">
        <view wx:if="{{week && date === today}}" class="card week rise">
          <view class="week-head">
            <view>
              <view class="t">这一周</view>
              <view class="s">{{week.line}}</view>
            </view>
            <view wx:if="{{week.planned}}" class="week-count"><text class="num big">{{week.done}}</text><text class="num">/{{week.planned}}</text><text class="u">次训练</text></view>
          </view>
          <view class="week-dots">
            <view wx:for="{{week.cells}}" wx:key="date" class="wcell">
              <view class="wdot {{item.state}} {{item.isToday ? 'today' : ''}}"><view wx:if="{{item.state === 'trained'}}" class="wtick"></view></view>
              <text class="wl {{item.isToday ? 'today' : ''}}">{{item.label}}</text>
            </view>
          </view>
          <view wx:if="{{week.streak >= 2}}" class="streak">已经连续打卡 <text class="num">{{week.streak}}</text> 天</view>
          <view wx:if="{{week.message}}" class="coach-says">
            <view class="cs-avatar">教</view>
            <view class="cs-bubble"><view class="cs-k">教练说</view><view class="cs-t">{{week.message}}</view></view>
          </view>
        </view>

        <view class="card feeling rise">
          <block wx:if="{{!feelingSent}}">
            <view class="feeling-head"><character catalog-id="ex-walk" size="{{72}}" /><view><view class="t">今天身体感觉怎么样</view><view class="s">点一下就好，教练会看到</view></view></view>
            <view class="feeling-row" wx:for="{{['pain', 'energy', 'hunger']}}" wx:for-item="field" wx:key="*this">
              <view wx:for="{{feelingOptions[field]}}" wx:key="value" class="feel-opt {{feeling[field] === item.value ? 'on' : ''}} {{item.value === 'present' ? 'pain' : ''}}" data-field="{{field}}" data-value="{{item.value}}" bindtap="pickFeeling">{{item.label}}</view>
            </view>
            <view class="feel-send" bindtap="sendFeeling">告诉教练</view>
          </block>
          <view wx:elif="{{feelingSent === 'pain'}}" class="feeling-result pain">
            <image class="safety-ic" src="/assets/icons/warning.svg" />
            <view><view class="t">先停下让你疼的动作</view><view class="s">教练已经收到提醒，会来问问你的情况。不要硬撑，也不用自己换动作。</view></view>
          </view>
          <view wx:else class="feeling-result">
            <character catalog-id="ex-jumping-jack" size="{{72}}" />
            <view><view class="t">收到，教练会看到</view><view class="s">明天也记得告诉我感觉怎么样。</view></view>
          </view>
        </view>

      </view>
    </plan-day>
  </block>

  <view wx:elif="{{status === 'waiting_for_coach'}}" class="state-card rise">
    <character catalog-id="ex-walk" size="{{120}}" />
    <view class="t">教练正在为这一天做安排</view>
    <view class="s">计划确认后会出现在这里，不用一直刷新。</view>
  </view>

  <view wx:elif="{{status === 'error'}}" class="state-card rise">
    <view class="t">暂时没连上</view>
    <view class="s">网络不太稳定，稍后再试一下。</view>
    <view class="retry" bindtap="retry">重新加载</view>
  </view>

  <view wx:else class="skeleton">
    <view class="sk sk-hero"></view>
    <view class="sk sk-row"></view>
    <view class="sk sk-row"></view>
  </view>
</view>

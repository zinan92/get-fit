<view class="page">
  <view class="row"><view><view class="eyebrow">{{displayDate}}</view><view class="title">早上好，{{clientName}}</view><view class="muted">今天也照顾好自己的身体。</view></view><view class="pill">{{dayIndex}}</view></view>
  <view class="card plan-card" wx:if="{{status === 'ready'}}">
    <view class="row"><view><view class="eyebrow">今日主题</view><view class="section-title">{{day.title}}</view></view><view class="pill">教练已确认</view></view>
    <view class="muted">训练 {{day.exercises.length}} 个动作 · 饮食 {{day.meals.length}} 餐 · 约 {{totalKcal}} kcal</view>
  </view>
  <view class="card" wx:else><view class="section-title">今日计划正在确认</view><view class="muted">教练发布后会出现在这里。你可以先喝水、散步和好好休息。</view></view>
  <view class="card" wx:if="{{status === 'ready'}}">
    <view class="section-title">今天练什么</view>
    <block wx:for="{{day.exercises}}" wx:key="catalogId">
      <view class="exercise-card">
        <view class="row exercise-head" data-id="{{item.catalogId}}" bindtap="toggleExerciseDetails">
          <view class="exercise-media">
            <image wx:if="{{item.mediaPath}}" src="{{item.mediaPath}}" mode="aspectFill" lazy-load="true" />
            <view wx:else class="exercise-media-fallback">动作要领</view>
          </view>
          <view class="exercise-copy"><view class="exercise-name">{{item.name}}</view><view class="muted">{{item.sets}} 组 × {{item.reps}} 次 · 休息 {{item.restSeconds}} 秒</view><view class="tag-row"><text wx:if="{{item.target}}">目标：{{item.target}}</text><text wx:if="{{item.equipment}}">{{item.equipment}}</text></view></view>
          <button class="item-check" size="mini" data-id="{{item.catalogId}}" catchtap="toggleExercise">{{done[item.catalogId] ? '✓' : '完成'}}</button>
        </view>
        <view wx:if="{{item.open}}" class="exercise-details">
          <view class="details-heading"><text>动作要领</text><text>{{item.steps.length}} 步</text></view>
          <view wx:for="{{item.steps}}" wx:for-item="step" wx:for-index="stepIndex" wx:key="stepIndex" class="step-row"><text class="step-number">{{stepIndex + 1}}</text><text>{{step}}</text></view>
          <view class="details-note">按自己的舒适范围完成；出现疼痛时先停下，并联系教练。</view>
        </view>
      </view>
    </block>
  </view>
  <view class="card" wx:if="{{status === 'ready'}}"><view class="section-title">今天吃什么</view><block wx:for="{{day.meals}}" wx:key="mealType"><view class="meal"><view class="row"><view><text class="meal-name">{{item.label}}</text><text class="pill">{{item.mealKcal}} kcal</text></view><button class="item-check meal-button" size="mini" data-id="{{item.mealType}}" catchtap="toggleMeal">{{done[item.mealType] ? '已吃完' : '完成打卡'}}</button></view><view class="food-row" wx:for="{{item.foods}}" wx:for-item="food" wx:key="foodCatalogId"><text>{{food.name}}</text><text>{{food.grams}}{{food.unit}} · {{food.kcal}} kcal</text></view></view></block></view>
  <view class="card" wx:if="{{status === 'ready' && day.reminders.length}}"><view class="section-title">今天注意</view><view class="muted" wx:for="{{day.reminders}}" wx:key="*this">· {{item}}</view></view>
  <view class="card" wx:if="{{status === 'ready'}}"><view class="row"><view><view class="section-title compact-title">喝水</view><view class="muted">少量多次，目标约 2L</view></view><button class="item-check" size="mini" data-id="water" bindtap="toggleWater">{{done.water ? '已完成' : '完成'}}</button></view></view>
  <button class="button" bindtap="openFeedback">提交今天的身体反馈</button>
  <button class="button secondary" bindtap="requestReminder">开启每日计划提醒</button>
</view>

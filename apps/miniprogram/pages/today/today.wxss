.topbtn { display: flex; align-items: center; gap: 12rpx; border: 3rpx solid var(--line-2); background: var(--surface); color: var(--ink); padding: 10rpx 22rpx; border-radius: 999rpx; font-size: 24rpx; font-weight: 600; transition: transform .3s var(--spring); }
.topbtn:active { transform: scale(.94); }
.topbtn-ic { width: 26rpx; height: 26rpx; }

.greet { padding: 4rpx 32rpx 24rpx; display: flex; align-items: flex-start; gap: 24rpx; }
.greet-text { flex: 1; }
.greet .eyebrow { font-size: 23rpx; color: var(--train); font-weight: 600; }
.greet .h1 { margin: 10rpx 0 8rpx; font-size: 42rpx; font-weight: 700; letter-spacing: -.01em; }
.greet .sub { font-size: 25rpx; color: var(--ink-2); }
.avatar { flex: 0 0 68rpx; width: 68rpx; height: 68rpx; border-radius: 50%; background: var(--diet-soft); color: var(--diet); display: flex; align-items: center; justify-content: center; font-size: 28rpx; }

.datestrip { display: flex; gap: 14rpx; padding: 0 32rpx 32rpx; }
.dcell { flex: 1; display: flex; flex-direction: column; align-items: center; border-radius: 28rpx; padding: 16rpx 0 14rpx; background: var(--surface); border: 3rpx solid var(--line); transition: background .3s var(--ease), border-color .3s var(--ease), transform .35s var(--spring); }
.dcell:active { transform: scale(.95); }
.dcell .wd { font-size: 21rpx; color: var(--ink-3); }
.dcell .dn { font-size: 30rpx; margin-top: 4rpx; color: var(--ink); }
.dcell .dot { width: 8rpx; height: 8rpx; border-radius: 50%; background: var(--train); margin-top: 8rpx; }
.dcell.sel { background: var(--ink); border-color: var(--ink); }
.dcell.sel .wd { color: #D8CBAE; }
.dcell.sel .dn { color: #fff; }
.dcell.sel .dot { background: var(--train-soft); }

.feeling { margin-top: 28rpx; }
.feeling-head { display: flex; align-items: center; gap: 18rpx; margin-bottom: 20rpx; }
.feeling-head .t, .feeling-result .t { font-size: 28rpx; font-weight: 700; }
.feeling-head .s, .feeling-result .s { font-size: 23rpx; color: var(--ink-2); margin-top: 4rpx; line-height: 1.55; }
.feeling-row { display: flex; gap: 12rpx; margin-bottom: 14rpx; }
.feel-opt { flex: 1; text-align: center; padding: 16rpx 0; border-radius: 22rpx; background: var(--surface-2); border: 3rpx solid var(--line); font-size: 24rpx; color: var(--ink-2); transition: background .25s var(--ease), border-color .25s, color .25s, transform .35s var(--spring); }
.feel-opt:active { transform: scale(.95); }
.feel-opt.on { background: var(--diet-soft); border-color: var(--diet); color: var(--diet); font-weight: 700; }
.feel-opt.pain.on { background: var(--warn-soft); border-color: var(--warn); color: #7A5205; }
.feel-send { margin-top: 10rpx; height: 80rpx; border-radius: 999rpx; background: var(--ink); color: #fff; font-size: 27rpx; font-weight: 700; display: flex; align-items: center; justify-content: center; }
.feeling-result { display: flex; align-items: center; gap: 20rpx; }
.feeling-result.pain { align-items: flex-start; background: var(--warn-soft); margin: -32rpx; padding: 32rpx; border-radius: 44rpx; }

.skeleton { padding: 0 32rpx; display: flex; flex-direction: column; gap: 24rpx; }
.sk { background: var(--surface); border: 2rpx solid var(--line); border-radius: 44rpx; animation: breathe 1.4s var(--ease) infinite; }
.sk-hero { height: 320rpx; }
.sk-row { height: 170rpx; }
@keyframes breathe { 0%, 100% { opacity: 1; } 50% { opacity: .55; } }

.safety-ic { flex: 0 0 32rpx; width: 32rpx; height: 32rpx; margin-top: 2rpx; }

@media (prefers-reduced-motion: reduce) {
  .sk { animation: none; }
  .dcell, .feel-opt { transition: none; }
}
.week { margin-top: 28rpx; }
.week-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 20rpx; }
.week-head .t { font-size: 30rpx; font-weight: 700; }
.week-head .s { font-size: 23rpx; color: var(--ink-2); margin-top: 6rpx; line-height: 1.5; }
.week-count { flex: 0 0 auto; display: flex; align-items: baseline; color: var(--ink-3); font-size: 24rpx; }
.week-count .big { font-size: 52rpx; color: var(--train); margin-right: 2rpx; }
.week-count .u { font-size: 21rpx; margin-left: 8rpx; }
.week-dots { display: flex; justify-content: space-between; margin-top: 26rpx; }
.wcell { display: flex; flex-direction: column; align-items: center; gap: 10rpx; }
.wdot { width: 60rpx; height: 60rpx; border-radius: 22rpx; border: 4rpx solid var(--line); background: var(--surface); display: flex; align-items: center; justify-content: center; transform: rotate(-6deg); }
.wdot.planned { border-color: var(--train-soft); border-style: dashed; }
.wdot.missed { border-color: var(--line-2); }
.wdot.trained { background: var(--train); border-color: var(--train); transform: rotate(0deg); }
.wdot.rest { width: 30rpx; height: 30rpx; margin: 15rpx 0; border-radius: 50%; border-color: var(--diet-soft); background: var(--diet-soft); transform: none; }
.wdot.rest-done { width: 30rpx; height: 30rpx; margin: 15rpx 0; border-radius: 50%; border-color: var(--diet); background: var(--diet); transform: none; }
.wdot.none { width: 16rpx; height: 16rpx; margin: 22rpx 0; border-radius: 50%; border: none; background: var(--line); transform: none; }
.wdot.today { box-shadow: 0 0 0 6rpx var(--surface), 0 0 0 9rpx var(--ink); }
.wtick { width: 22rpx; height: 12rpx; border-left: 5rpx solid #fff; border-bottom: 5rpx solid #fff; transform: translateY(-3rpx) rotate(-45deg); }
.wl { font-size: 21rpx; color: var(--ink-3); }
.wl.today { color: var(--ink); font-weight: 700; }
.streak { margin-top: 22rpx; display: inline-block; padding: 8rpx 20rpx; border-radius: 999rpx; background: var(--train-soft); color: var(--train); font-size: 23rpx; font-weight: 700; }
.coach-says { margin-top: 24rpx; display: flex; gap: 16rpx; align-items: flex-start; }
.cs-avatar { flex: 0 0 60rpx; width: 60rpx; height: 60rpx; border-radius: 50%; background: var(--diet-soft); color: var(--diet); font-size: 24rpx; font-weight: 700; display: flex; align-items: center; justify-content: center; }
.cs-bubble { flex: 1; background: var(--surface-2); border: 2rpx solid var(--line); border-radius: 8rpx 30rpx 30rpx 30rpx; padding: 16rpx 22rpx; }
.cs-k { font-size: 20rpx; color: var(--diet); font-weight: 700; }
.cs-t { font-size: 26rpx; line-height: 1.55; margin-top: 4rpx; }

.topbtn { display: flex; align-items: center; gap: 12rpx; border: 3rpx solid var(--line-2); background: var(--surface); color: var(--ink); padding: 10rpx 22rpx; border-radius: 999rpx; font-size: 24rpx; font-weight: 600; transition: transform .3s var(--spring); }
.topbtn:active { transform: scale(.94); }
.topbtn-ic { width: 26rpx; height: 26rpx; }

.greet { padding: 4rpx 32rpx 24rpx; display: flex; align-items: flex-start; gap: 24rpx; }
.greet-text { flex: 1; }
.greet .eyebrow { font-size: 23rpx; color: var(--train); font-weight: 600; }
.greet .h1 { margin: 10rpx 0 8rpx; font-size: 42rpx; font-weight: 700; letter-spacing: -.01em; }
.greet .sub { font-size: 25rpx; color: var(--ink-2); }
.avatar { flex: 0 0 68rpx; width: 68rpx; height: 68rpx; border-radius: 50%; background: var(--diet-soft); color: var(--diet); display: flex; align-items: center; justify-content: center; font-size: 28rpx; }

.datestrip { display: flex; gap: 14rpx; padding: 0 32rpx 32rpx; }
.dcell { flex: 1; display: flex; flex-direction: column; align-items: center; border-radius: 28rpx; padding: 16rpx 0 14rpx; background: var(--surface); border: 3rpx solid var(--line); transition: background .3s var(--ease), border-color .3s var(--ease), transform .35s var(--spring); }
.dcell:active { transform: scale(.95); }
.dcell .wd { font-size: 21rpx; color: var(--ink-3); }
.dcell .dn { font-size: 30rpx; margin-top: 4rpx; color: var(--ink); }
.dcell .dot { width: 8rpx; height: 8rpx; border-radius: 50%; background: var(--train); margin-top: 8rpx; }
.dcell.sel { background: var(--ink); border-color: var(--ink); }
.dcell.sel .wd { color: #D8CBAE; }
.dcell.sel .dn { color: #fff; }
.dcell.sel .dot { background: var(--train-soft); }

.hero { display: flex; flex-direction: column; gap: 24rpx; }
.hero-top { display: flex; align-items: center; gap: 16rpx; }
.dayof { margin-left: auto; font-size: 24rpx; color: var(--ink-3); }
.dayof .strong { color: var(--ink); }
.hero-mid { display: flex; align-items: center; gap: 28rpx; }
.hero-copy { flex: 1; min-width: 0; }
.hero .eyebrow { font-size: 22rpx; color: var(--ink-3); letter-spacing: .06em; }
.hero .h2 { margin: 8rpx 0 18rpx; font-size: 44rpx; font-weight: 700; letter-spacing: -.01em; }
.metachips { display: flex; gap: 14rpx; flex-wrap: wrap; }
.metachips > text { font-size: 23rpx; font-weight: 600; color: var(--ink-2); background: var(--surface-2); border: 2rpx solid var(--line); padding: 8rpx 18rpx; border-radius: 999rpx; }
.ring { flex: 0 0 148rpx; width: 148rpx; height: 148rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; }
.ring-in { width: 120rpx; height: 120rpx; border-radius: 50%; background: var(--surface); display: flex; flex-direction: column; align-items: center; justify-content: center; }
.ring-pct { font-size: 34rpx; }
.ring-lb { font-size: 17rpx; color: var(--ink-3); margin-top: 2rpx; }
.ring.full .ring-lb { color: var(--diet); font-weight: 700; }
.quote { font-size: 25rpx; color: var(--ink-2); line-height: 1.6; padding-top: 20rpx; border-top: 2rpx dashed var(--line); font-style: italic; }
.quote .q { font-style: normal; color: var(--train); font-weight: 700; }

.exlist { margin: 0 32rpx 28rpx; background: var(--surface); border-radius: 44rpx; border: 2rpx solid var(--line); overflow: hidden; }
.exercise-item + .exercise-item { border-top: 2rpx solid var(--line); }
.exrow { display: flex; align-items: center; gap: 22rpx; padding: 24rpx 28rpx; }
.exidx { font-size: 22rpx; color: var(--ink-3); width: 32rpx; }
.exdemo-tile { flex: 0 0 124rpx; width: 124rpx; height: 124rpx; border-radius: 32rpx; background: var(--surface-2); border: 2rpx solid var(--line); overflow: hidden; }
.exb { flex: 1; min-width: 0; }
.exb .n { font-size: 28rpx; font-weight: 700; }
.exb .s { font-size: 24rpx; margin-top: 6rpx; color: var(--ink-2); }
.exb .s .hl { color: var(--train); }
.exb .cue { font-size: 22rpx; color: var(--ink-3); margin-top: 4rpx; }

.exdetail { max-height: 0; overflow: hidden; background: var(--surface-2); transition: max-height .4s var(--ease); }
.exdetail.open { max-height: 2400rpx; }
.exdetail-in { padding: 12rpx 32rpx 32rpx; }
.exdetail-head { display: flex; align-items: baseline; gap: 16rpx; margin-bottom: 16rpx; }
.exdetail-head .lb { font-size: 23rpx; font-weight: 700; color: var(--train); }
.exdetail-head .steps-n { margin-left: auto; font-size: 22rpx; color: var(--ink-3); }
.tagrow { display: flex; gap: 12rpx; margin-bottom: 18rpx; flex-wrap: wrap; }
.tagrow text { font-size: 21rpx; color: var(--ink-2); background: var(--surface); border: 2rpx solid var(--line); padding: 6rpx 16rpx; border-radius: 999rpx; }
.steplist { display: flex; flex-direction: column; gap: 14rpx; margin-bottom: 20rpx; }
.step { display: flex; gap: 18rpx; font-size: 25rpx; color: var(--ink-2); line-height: 1.55; }
.step-n { flex: 0 0 34rpx; width: 34rpx; height: 34rpx; border-radius: 50%; background: var(--train); color: #fff; font-size: 19rpx; display: flex; align-items: center; justify-content: center; margin-top: 4rpx; }
.step-t { flex: 1; }
.safenote { font-size: 23rpx; color: var(--ink-2); border-top: 2rpx dashed var(--line-2); padding-top: 18rpx; }

.safetybar { margin: 0 32rpx 8rpx; display: flex; align-items: flex-start; gap: 18rpx; background: var(--warn-soft); color: #7A5205; border-radius: 28rpx; padding: 20rpx 24rpx; font-size: 24rpx; line-height: 1.5; }
.safety-ic { flex: 0 0 32rpx; width: 32rpx; height: 32rpx; margin-top: 2rpx; }

.recovery { display: flex; align-items: center; gap: 24rpx; background: var(--diet-soft); border-color: transparent; }
.recovery-copy .t { font-size: 28rpx; font-weight: 700; }
.recovery-copy .s { font-size: 24rpx; color: var(--ink-2); margin-top: 4rpx; }

.feeling { margin-top: 28rpx; }
.feeling-head { display: flex; align-items: center; gap: 18rpx; margin-bottom: 20rpx; }
.feeling-head .t, .feeling-result .t { font-size: 28rpx; font-weight: 700; }
.feeling-head .s, .feeling-result .s { font-size: 23rpx; color: var(--ink-2); margin-top: 4rpx; line-height: 1.55; }
.feeling-row { display: flex; gap: 12rpx; margin-bottom: 14rpx; }
.feel-opt { flex: 1; text-align: center; padding: 16rpx 0; border-radius: 22rpx; background: var(--surface-2); border: 3rpx solid var(--line); font-size: 24rpx; color: var(--ink-2); transition: background .25s var(--ease), border-color .25s, color .25s, transform .35s var(--spring); }
.feel-opt:active { transform: scale(.95); }
.feel-opt.on { background: var(--diet-soft); border-color: var(--diet); color: var(--diet); font-weight: 700; }
.feel-opt.pain.on { background: var(--warn-soft); border-color: var(--warn); color: #7A5205; }
.feel-send { margin-top: 10rpx; height: 80rpx; border-radius: 999rpx; background: var(--ink); color: #fff; font-size: 27rpx; font-weight: 700; display: flex; align-items: center; justify-content: center; }
.feeling-result { display: flex; align-items: center; gap: 20rpx; }
.feeling-result.pain { align-items: flex-start; background: var(--warn-soft); margin: -32rpx; padding: 32rpx; border-radius: 44rpx; }
.meals-head { margin-top: 36rpx; }
.meal { margin: 0 32rpx 28rpx; background: var(--surface); border-radius: 44rpx; border: 2rpx solid var(--line); padding: 30rpx; }
.meal-head { display: flex; align-items: center; gap: 18rpx; margin-bottom: 24rpx; }
.meal-name { font-size: 29rpx; font-weight: 700; }
.pill { margin-left: auto; display: flex; align-items: center; gap: 14rpx; border-radius: 999rpx; padding: 8rpx 24rpx 8rpx 8rpx; background: var(--surface-2); border: 3rpx solid var(--line); transition: background-color .3s var(--ease), border-color .3s var(--ease); }
.pill-badge { width: 52rpx; height: 52rpx; border-radius: 18rpx; background: var(--surface); border: 4rpx solid var(--line-2); display: flex; align-items: center; justify-content: center; transform: rotate(-9deg); transition: transform .5s var(--spring), background-color .25s, border-color .25s; }
.check-mark.small { width: 20rpx; height: 11rpx; border-left-width: 5rpx; border-bottom-width: 5rpx; }
.pill .lb { font-size: 23rpx; font-weight: 700; color: var(--ink-2); transition: color .3s; }
.pill.on { background: var(--diet-soft); border-color: var(--diet); }
.pill.on .pill-badge { transform: rotate(0) scale(1.1); background: var(--diet); border-color: var(--diet); }
.pill.on .lb { color: var(--diet); }

.foods { display: flex; gap: 18rpx; margin-bottom: 22rpx; }
.food { flex: 1; min-width: 0; text-align: center; }
.food-img { width: 100%; height: 190rpx; display: block; margin-bottom: 8rpx; }
.food.cheer .food-img { animation: cheer .6s var(--spring); }
@keyframes cheer { 0% { transform: none; } 35% { transform: translateY(-10rpx) scale(1.1) rotate(-4deg); } 100% { transform: none; } }
.fn { font-size: 23rpx; font-weight: 700; line-height: 1.3; }
.fg { font-size: 20rpx; color: var(--ink-3); margin-top: 2rpx; font-weight: 500; }
.fk { display: inline-block; margin-top: 8rpx; font-size: 21rpx; color: var(--diet); background: var(--diet-soft); border-radius: 14rpx; padding: 2rpx 12rpx; }
.mealsum { display: flex; justify-content: space-between; align-items: baseline; padding-top: 20rpx; border-top: 2rpx dashed var(--line-2); }
.mealsum .lb { font-size: 24rpx; color: var(--ink-2); }
.mealsum .vv { font-size: 30rpx; color: var(--diet); }
.credit { margin: 16rpx 32rpx 36rpx; font-size: 21rpx; color: var(--ink-3); text-align: center; }

.skeleton { padding: 0 32rpx; display: flex; flex-direction: column; gap: 24rpx; }
.sk { background: var(--surface); border: 2rpx solid var(--line); border-radius: 44rpx; animation: breathe 1.4s var(--ease) infinite; }
.sk-hero { height: 320rpx; }
.sk-row { height: 170rpx; }
@keyframes breathe { 0%, 100% { opacity: 1; } 50% { opacity: .55; } }

@media (prefers-reduced-motion: reduce) {
  .food.cheer .food-img, .sk { animation: none; }
  .exdetail, .pill, .pill-badge, .dcell { transition: none; }
}

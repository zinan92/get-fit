.plan-card { background: linear-gradient(145deg, #f47b42, #e96332); color: #fff; }
.plan-card .eyebrow { color: #fff; opacity: .8; }
.item { padding: 20rpx 0; border-bottom: 1px solid #eee9e1; }
.item button { margin: 0; }
.exercise-card { background: #fffaf4; border: 1rpx solid #f0e2d6; border-radius: 22rpx; padding: 18rpx; margin: 16rpx 0; }
.exercise-head { align-items: center; gap: 16rpx; }
.exercise-media { width: 132rpx; height: 132rpx; border-radius: 22rpx; overflow: hidden; background: #f4f0e8; flex: 0 0 auto; }
.exercise-media image { display: block; width: 100%; height: 100%; }
.exercise-media-fallback { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; color: #aaa095; font-size: 20rpx; }
.exercise-copy { flex: 1; min-width: 0; }
.exercise-name { font-size: 29rpx; font-weight: 800; color: #302f2b; margin-bottom: 6rpx; }
.tag-row { display: flex; flex-wrap: wrap; gap: 8rpx; margin-top: 8rpx; }
.tag-row text { background: #fff; border-radius: 999rpx; padding: 5rpx 9rpx; color: #8b7565; font-size: 19rpx; }
.item-check { flex: 0 0 auto; margin: 0 !important; padding: 0 18rpx; line-height: 64rpx; border-radius: 999rpx; background: #f47b42; color: #fff; font-size: 21rpx; }
.exercise-details { margin: 16rpx 0 2rpx; padding: 18rpx; border-radius: 18rpx; background: #fff; }
.details-heading { display: flex; justify-content: space-between; color: #d85c28; font-size: 22rpx; font-weight: 800; margin-bottom: 12rpx; }
.details-heading text:last-child { color: #b18b72; font-weight: 400; }
.step-row { display: flex; gap: 12rpx; color: #62584e; font-size: 22rpx; line-height: 1.55; margin: 10rpx 0; }
.step-number { width: 34rpx; height: 34rpx; border-radius: 50%; background: #fff0e5; color: #d85c28; display: inline-flex; align-items: center; justify-content: center; flex: 0 0 auto; font-size: 19rpx; font-weight: 800; }
.details-note { border-top: 1rpx dashed #ead8c9; margin-top: 14rpx; padding-top: 12rpx; color: #9c806c; font-size: 20rpx; line-height: 1.5; }
.meal { background: #f8f3e9; border-radius: 18rpx; padding: 18rpx; margin: 14rpx 0; }
.meal-name { color: #d85c28; font-size: 28rpx; font-weight: 800; margin-right: 10rpx; }
.meal-button { background: #fff5ed; color: #d85c28; border: 1rpx solid #f5c7ae; }
.food-row { display: flex; justify-content: space-between; gap: 16rpx; padding: 14rpx 0 0; color: #62584e; font-size: 22rpx; }
.food-row text:last-child { color: #8b7565; white-space: nowrap; }
.compact-title { margin: 0; font-size: 28rpx; }

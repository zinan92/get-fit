.coach { padding-bottom: calc(60rpx + env(safe-area-inset-bottom)); }
.head { padding: 4rpx 32rpx 28rpx; }
.head .eyebrow { font-size: 23rpx; color: var(--train); font-weight: 600; }
.head .h1 { margin-top: 8rpx; font-size: 42rpx; font-weight: 700; }
.section { margin-bottom: 28rpx; }
.sec-head .count { font-size: 22rpx; }

.alert-card { margin: 0 32rpx 16rpx; display: flex; align-items: center; gap: 18rpx; padding: 24rpx 26rpx; background: var(--warn-soft); border-radius: 32rpx; }
.alert-ic { flex: 0 0 36rpx; width: 36rpx; height: 36rpx; }
.alert-copy { flex: 1; }
.alert-copy .t { font-size: 27rpx; font-weight: 700; color: #7A5205; }
.alert-copy .s { font-size: 22rpx; color: var(--ink-2); margin-top: 4rpx; }
.ack { padding: 12rpx 24rpx; border-radius: 999rpx; background: var(--surface); border: 3rpx solid var(--warn); color: #7A5205; font-size: 24rpx; font-weight: 700; }

.list { margin: 0 32rpx; background: var(--surface); border: 2rpx solid var(--line); border-radius: 40rpx; overflow: hidden; }
.client-row { display: flex; align-items: center; gap: 20rpx; padding: 26rpx 28rpx; }
.client-row + .client-row { border-top: 2rpx solid var(--line); }
.avatar { flex: 0 0 72rpx; width: 72rpx; height: 72rpx; border-radius: 50%; background: var(--diet-soft); color: var(--diet); display: flex; align-items: center; justify-content: center; font-size: 28rpx; font-weight: 700; }
.who { flex: 1; min-width: 0; }
.who .n { font-size: 29rpx; font-weight: 700; }
.warn-text { font-size: 22rpx; color: var(--warn); margin-top: 4rpx; }
.stage { font-size: 22rpx; font-weight: 700; padding: 8rpx 18rpx; border-radius: 999rpx; white-space: nowrap; }
.stage.muted { background: var(--surface-2); color: var(--ink-3); border: 2rpx solid var(--line); }
.stage.action { background: var(--train-soft); color: var(--train); }
.stage.warn { background: var(--warn-soft); color: #7A5205; }
.stage.diet { background: var(--diet-soft); color: var(--diet); }

.invite .field { height: 88rpx; padding: 0 28rpx; background: var(--surface-2); border: 3rpx solid var(--line); border-radius: 26rpx; font-size: 29rpx; }
.primary { margin-top: 20rpx; height: 88rpx; border-radius: 999rpx; background: var(--train); color: #fff; font-size: 29rpx; font-weight: 700; display: flex; align-items: center; justify-content: center; }
.invite-ok { font-size: 26rpx; color: var(--ink-2); }
.share { margin-top: 20rpx; height: 88rpx; line-height: 88rpx; border-radius: 999rpx; background: var(--diet); color: #fff; font-size: 29rpx; font-weight: 700; }
.share::after { border: none; }
.copy { margin-top: 16rpx; text-align: center; font-size: 25rpx; color: var(--ink-3); }

.coach-edit { padding-bottom: calc(190rpx + env(safe-area-inset-bottom)); }
.head { padding: 4rpx 32rpx 24rpx; }
.head .eyebrow { font-size: 23rpx; color: var(--warn); font-weight: 600; }
.head .h1 { margin-top: 8rpx; font-size: 40rpx; font-weight: 700; }
.head .sub { margin-top: 8rpx; font-size: 24rpx; color: var(--ink-2); line-height: 1.55; }

.basics .label { font-size: 22rpx; color: var(--ink-3); margin-bottom: 10rpx; }
.basics .label + .field { margin-bottom: 24rpx; }
.field { width: 100%; min-height: 80rpx; padding: 18rpx 24rpx; border-radius: 24rpx; background: var(--surface-2); border: 2rpx solid var(--line); font-size: 28rpx; box-sizing: border-box; }
.field.area { min-height: 96rpx; line-height: 1.5; }

.empty-note { font-size: 25rpx; color: var(--ink-2); padding: 28rpx 32rpx; }
.move { padding: 24rpx 28rpx; margin-bottom: 20rpx; }
.move.flagged, .food.flagged { border-color: var(--warn); background: var(--warn-soft); }
.move-top { display: flex; align-items: center; gap: 18rpx; }
.thumb { flex: 0 0 104rpx; height: 104rpx; border-radius: 28rpx; background: var(--train-soft); overflow: hidden; }
.move-name { flex: 1; min-width: 0; }
.move-name .n, .food-name .n { font-size: 29rpx; font-weight: 700; }
.flag { font-size: 21rpx; color: var(--warn); margin-top: 4rpx; }
.mini-btn { padding: 12rpx 24rpx; border-radius: 999rpx; background: var(--ink); color: #fff; font-size: 24rpx; font-weight: 700; }
.mini-btn.ghost { background: var(--surface); color: var(--ink-2); border: 2rpx solid var(--line-2); }
.steppers { display: flex; gap: 14rpx; margin-top: 20rpx; }
.stepper { flex: 1; background: var(--surface-2); border: 2rpx solid var(--line); border-radius: 26rpx; padding: 12rpx 10rpx; display: flex; flex-direction: column; align-items: center; gap: 6rpx; }
.stepper .k { font-size: 20rpx; color: var(--ink-3); }
.ctl { display: flex; align-items: center; gap: 10rpx; }
.pm { width: 52rpx; height: 52rpx; border-radius: 18rpx; background: var(--surface); border: 2rpx solid var(--line-2); display: flex; align-items: center; justify-content: center; font-size: 32rpx; color: var(--ink-2); }
.pm:active { transform: scale(.92); background: var(--train-soft); }
.ctl .v { min-width: 64rpx; text-align: center; font-size: 32rpx; color: var(--train); }
.add-row, .add-food { margin: 0 32rpx 36rpx; padding: 22rpx; border-radius: 30rpx; border: 3rpx dashed var(--line-2); text-align: center; color: var(--ink-2); font-size: 26rpx; font-weight: 600; }
.add-food { margin: 16rpx 0 0; }

.meals-head { margin-top: 12rpx; }
.meal { padding: 24rpx 28rpx; margin-bottom: 22rpx; }
.meal-head { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 8rpx; }
.meal-head .t { font-size: 29rpx; font-weight: 700; }
.meal-head .kc { font-size: 22rpx; color: var(--diet); }
.food { display: flex; align-items: center; gap: 14rpx; padding: 14rpx 12rpx; border-radius: 24rpx; border: 2rpx solid transparent; }
.food + .food { border-top: 2rpx dashed var(--line); }
.food-img { flex: 0 0 72rpx; width: 72rpx; height: 72rpx; }
.food-name { flex: 1; min-width: 0; }
.food-name .n { font-size: 26rpx; }
.food-name .s { font-size: 21rpx; color: var(--ink-3); }
.ctl.small .pm { width: 46rpx; height: 46rpx; font-size: 28rpx; }
.ctl.small .v { min-width: 96rpx; font-size: 26rpx; color: var(--diet); }
.ctl .u { font-size: 18rpx; margin-left: 2rpx; }
.food-actions { display: flex; flex-direction: column; gap: 8rpx; align-items: center; }
.link { font-size: 23rpx; font-weight: 700; color: var(--ink); padding: 4rpx 10rpx; }
.muted-link { color: var(--ink-3); }
.muted-link.off { opacity: .35; }

.actions { position: fixed; left: 0; right: 0; bottom: 0; display: flex; gap: 18rpx; padding: 20rpx 32rpx calc(24rpx + env(safe-area-inset-bottom)); background: rgba(243, 238, 227, .95); border-top: 2rpx solid var(--line); z-index: 10; }
.back { flex: 0 0 180rpx; height: 92rpx; border-radius: 999rpx; border: 3rpx solid var(--line-2); background: var(--surface); display: flex; align-items: center; justify-content: center; font-size: 28rpx; font-weight: 700; color: var(--ink-2); }
.publish { flex: 1; height: 92rpx; border-radius: 999rpx; background: var(--train); color: #fff; display: flex; align-items: center; justify-content: center; font-size: 29rpx; font-weight: 700; transition: opacity .2s; }
.publish.idle { opacity: .55; }

.sheet-mask { position: fixed; left: 0; right: 0; top: 0; bottom: 0; background: rgba(46, 42, 36, .38); z-index: 20; display: flex; align-items: flex-end; animation: fade .2s var(--ease); }
.sheet { width: 100%; max-height: 78vh; background: var(--paper); border-radius: 44rpx 44rpx 0 0; padding: 28rpx 0 calc(20rpx + env(safe-area-inset-bottom)); display: flex; flex-direction: column; animation: up .32s var(--spring); }
.sheet-head { display: flex; justify-content: space-between; align-items: baseline; padding: 0 32rpx 18rpx; }
.sheet-head .t { font-size: 32rpx; font-weight: 700; }
.sheet-head .x { font-size: 25rpx; color: var(--ink-2); }
.groups { white-space: nowrap; padding: 0 24rpx 18rpx; }
.group { display: inline-block; margin: 0 8rpx; padding: 12rpx 26rpx; border-radius: 999rpx; background: var(--surface); border: 2rpx solid var(--line); font-size: 25rpx; color: var(--ink-2); }
.group.on { background: var(--ink); border-color: var(--ink); color: #fff; font-weight: 700; }
.sheet-list { height: 56vh; padding: 0 32rpx; box-sizing: border-box; }
.opt { display: flex; align-items: center; gap: 20rpx; padding: 16rpx 20rpx; margin-bottom: 14rpx; background: var(--surface); border: 2rpx solid var(--line); border-radius: 30rpx; }
.opt:active { background: var(--train-soft); }
.opt-img { flex: 0 0 80rpx; width: 80rpx; height: 80rpx; }
.opt-thumb { flex: 0 0 80rpx; height: 80rpx; border-radius: 22rpx; background: var(--train-soft); overflow: hidden; }
.opt-copy .n { font-size: 28rpx; font-weight: 700; }
.opt-copy .s { font-size: 22rpx; color: var(--ink-3); margin-top: 4rpx; }
.opt-empty { padding: 60rpx 0; text-align: center; color: var(--ink-3); font-size: 25rpx; }
@keyframes up { from { transform: translateY(100%); } to { transform: none; } }
@keyframes fade { from { opacity: 0; } to { opacity: 1; } }
@media (prefers-reduced-motion: reduce) { .sheet, .sheet-mask { animation: none; } }

<view class="page">
  <topbar />
  <view wx:if="{{preview}}" class="preview-banner">本地预览数据 · 未连接云开发</view>
  <view wx:if="{{isCoach}}" class="card coach-entry" bindtap="openCoach">
    <view class="eyebrow">教练</view>
    <view class="title">教练工作台</view>
    <view class="muted">邀请客户、确认资料、审阅和发布计划、处理身体提醒。</view>
  </view>
  <view class="card">
    <view class="eyebrow">我的</view>
    <view class="title">{{client.displayName || '我的资料'}}</view>
    <view class="muted">轻练只在你同意后处理必要资料。你看到的计划都由教练确认后发布。</view>
  </view>
  <view class="card">
    <view class="section-title">已记录的同意</view>
    <view wx:if="{{!consents.length}}" class="muted">还没有记录。</view>
    <view wx:for="{{consents}}" wx:key="*this" class="muted">· {{item}}</view>
  </view>
  <view class="card"><button bindtap="requestDelete" class="danger">申请删除我的资料</button></view>
  <view wx:if="{{accountId}}" class="account" bindtap="copyAccountId">账号编号 <text class="num">{{accountId[0]}}{{accountId[1]}}{{accountId[2]}}{{accountId[3]}}{{accountId[4]}}{{accountId[5]}}</text>… · 点此复制</view>
</view>

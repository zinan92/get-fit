page { background: #f8f3e9; color: #302f2b; font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif; }
.page { min-height: 100vh; padding: 32rpx; box-sizing: border-box; }
.card { background: #fffdf8; border-radius: 28rpx; padding: 28rpx; margin-bottom: 24rpx; box-shadow: 0 12rpx 36rpx rgba(50,44,36,.06); }
.button { background: #f47b42; color: #fff; border-radius: 999rpx; font-weight: 700; }
.button.secondary { background: #fff5ed; color: #d85d35; border: 1rpx solid #f5c7ae; }
.muted { color: #858177; font-size: 24rpx; }
.eyebrow { color: #d85c28; font-size: 22rpx; font-weight: 800; letter-spacing: 2rpx; }
.title { font-size: 44rpx; font-weight: 800; margin: 8rpx 0 12rpx; }
.section-title { font-size: 34rpx; font-weight: 800; margin: 20rpx 0; }
.row { display: flex; align-items: center; justify-content: space-between; }
.pill { background: #f5efe4; color: #858177; border-radius: 999rpx; padding: 8rpx 16rpx; font-size: 22rpx; }
.danger { background: #fff0ec; color: #a4554f; }

@import "/styles/numerals.wxss";

page {
  --paper: #F3EEE3; --surface: #FFFFFF; --surface-2: #FBF6EA;
  --ink: #2E2A24; --ink-2: #6B6255; --ink-3: #A79C8B;
  --line: #E6DDC9; --line-2: #D8CBAE;
  --train: #D85C28; --train-soft: #FBE4D3;
  --diet: #4F9D6E; --diet-soft: #E4F1E6;
  --warn: #A9720A; --warn-soft: #F7ECD3;
  --ease: cubic-bezier(.4, 0, .2, 1);
  --spring: cubic-bezier(.34, 1.56, .64, 1);
  background: var(--paper);
  color: var(--ink);
  font-family: "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", system-ui, sans-serif;
  font-size: 28rpx;
}
view, text { box-sizing: border-box; }
.num { font-family: "Fredoka", "PingFang SC", system-ui, sans-serif; font-weight: 600; font-variant-numeric: tabular-nums; }
.page { min-height: 100vh; padding-bottom: calc(150rpx + env(safe-area-inset-bottom)); }

.rise { animation: rise .5s var(--ease) both; }
@keyframes rise { from { opacity: 0; transform: translateY(20rpx); } to { opacity: 1; transform: none; } }

.preview-banner { margin: 0 32rpx 16rpx; padding: 10rpx 20rpx; border-radius: 999rpx; background: var(--warn-soft); color: #7A5205; font-size: 21rpx; text-align: center; }

.card { margin: 0 32rpx 32rpx; background: var(--surface); border-radius: 44rpx; padding: 32rpx; border: 2rpx solid var(--line); }
.chip { font-size: 22rpx; font-weight: 600; padding: 8rpx 18rpx; border-radius: 999rpx; }
.chip.confirmed { background: var(--diet-soft); color: var(--diet); display: inline-flex; align-items: center; gap: 10rpx; }
.chip.confirmed .dot { width: 10rpx; height: 10rpx; border-radius: 50%; background: var(--diet); }

.sec-head { padding: 0 32rpx; display: flex; align-items: baseline; gap: 16rpx; margin-bottom: 20rpx; }
.sec-head .eyebrow { font-size: 21rpx; letter-spacing: .14em; color: var(--ink-3); text-transform: uppercase; }
.sec-head .h3 { font-size: 34rpx; font-weight: 700; flex: 1; }
.sec-head .count { font-size: 22rpx; color: var(--ink-3); background: var(--surface-2); border: 2rpx solid var(--line); padding: 6rpx 16rpx; border-radius: 999rpx; }

/* Tilted until tapped, then it snaps upright and the tick draws in. */
.check-button { flex: 0 0 84rpx; width: 84rpx; height: 84rpx; border-radius: 28rpx; border: 4rpx solid var(--line-2); background: var(--surface); display: flex; align-items: center; justify-content: center; transform: rotate(-9deg); position: relative; box-shadow: 4rpx 6rpx 0 rgba(46, 42, 36, .08); transition: transform .5s var(--spring), background-color .25s, border-color .25s, box-shadow .35s; }
.check-button.on { transform: rotate(0deg) scale(1.08); box-shadow: 0 2rpx 0 rgba(46, 42, 36, .05); background: var(--train); border-color: var(--train); }
.check-mark { width: 30rpx; height: 17rpx; border-left: 6rpx solid #fff; border-bottom: 6rpx solid #fff; border-radius: 2rpx; transform: translateY(-4rpx) rotate(-45deg) scale(0); transition: transform .32s var(--spring) .14s; }
.on .check-mark { transform: translateY(-4rpx) rotate(-45deg) scale(1); }
.check-button .ripple { position: absolute; left: -8rpx; top: -8rpx; right: -8rpx; bottom: -8rpx; border-radius: 34rpx; border: 4rpx solid var(--train); opacity: 0; }
.check-button.pulse .ripple { animation: pulse .55s var(--ease); }
@keyframes pulse { from { opacity: .55; transform: scale(1); } to { opacity: 0; transform: scale(1.35); } }

.state-card { margin: 40rpx 32rpx; padding: 48rpx 36rpx; background: var(--surface); border: 2rpx solid var(--line); border-radius: 44rpx; text-align: center; }
.state-card .t { font-size: 32rpx; font-weight: 700; margin-top: 16rpx; }
.state-card .s { font-size: 25rpx; color: var(--ink-2); margin-top: 10rpx; line-height: 1.6; }
.state-card .retry { margin-top: 28rpx; display: inline-block; padding: 14rpx 36rpx; border-radius: 999rpx; background: var(--train); color: #fff; font-size: 26rpx; font-weight: 700; }

@media (prefers-reduced-motion: reduce) {
  .rise, .check-button.pulse .ripple { animation: none; }
  .check-button, .check-mark { transition: none; }
}

/* Form pages (onboarding, profile) until S2b gives them the full v3 treatment. */
.eyebrow { color: var(--train); font-size: 22rpx; font-weight: 700; letter-spacing: 2rpx; }
.title { font-size: 44rpx; font-weight: 700; margin: 8rpx 0 12rpx; }
.section-title { font-size: 32rpx; font-weight: 700; margin: 8rpx 0 20rpx; }
.muted { color: var(--ink-2); font-size: 25rpx; line-height: 1.6; }
.pill-tag { display: inline-block; background: var(--surface-2); color: var(--ink-2); border: 2rpx solid var(--line); border-radius: 999rpx; padding: 6rpx 18rpx; font-size: 22rpx; margin: 8rpx 0 16rpx; }
.button { margin-top: 24rpx; background: var(--train); color: #fff; border-radius: 999rpx; font-weight: 700; font-size: 30rpx; }
.danger { background: var(--warn-soft); color: #7A5205; border-radius: 999rpx; font-size: 28rpx; }
.field, .form-input { margin: 14rpx 0; padding: 22rpx 26rpx; background: var(--surface-2); border: 2rpx solid var(--line); border-radius: 24rpx; font-size: 28rpx; }
.consent { display: flex; align-items: flex-start; gap: 12rpx; margin: 18rpx 0; font-size: 26rpx; line-height: 1.5; }
